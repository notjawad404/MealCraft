# Copy to .env and fill in. Nothing here is read at import time, so the values
# can also come from the host's environment (Vercel project settings) instead.

CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/MealCraft?appName=<cluster>
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
JWT_SECRET=change-me


DNS_SERVERS=1.1.1.1,8.8.8.8


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


CLOUDINARY_FOLDER=mealcraft/recipes


# Cookbook sales. STRIPE_SECRET_KEY enables selling; without it paid cookbooks
# cannot be published or bought. STRIPE_WEBHOOK_SECRET is printed by
# `stripe listen --forward-to localhost:3001/stripe/webhook` in development,
# and comes from the endpoint's signing secret in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The platform's cut of each sale, as a percentage. The seller absorbs Stripe's
# processing fee, so this is what the platform keeps net.
PLATFORM_FEE_PERCENT=10

# Where Stripe returns the buyer after checkout and the seller after onboarding.
# Falls back to the first entry in ALLOWED_ORIGINS when unset.
FRONTEND_URL=http://localhost:5173
