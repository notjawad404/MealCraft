# Copy to .env and fill in. Nothing here is read at import time, so the values
# can also come from the host's environment (Vercel project settings) instead.

CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/MealCraft?appName=<cluster>
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
JWT_SECRET=change-me


DNS_SERVERS=1.1.1.1,8.8.8.8


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


CLOUDINARY_FOLDER=mealcraft/recipes
